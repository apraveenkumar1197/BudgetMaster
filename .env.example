# Copy this file to `.env` in the repo root.
#
# docker-compose.yml (dev) and docker-compose.prod.yml (prod) are independent,
# standalone files — never combined — so only fill in the section that matches
# how you're running things. docker compose auto-loads a `.env` file from this
# directory if present; values already exported in your shell/system
# environment take precedence over `.env`.

# ── Shared: Laravel API ──────────────────────────────────────────────────────
# Required — no safe default. Generate with:
#   docker run --rm -v "$(pwd)/laravel":/app -w /app php:8.2-cli php artisan key:generate --show
APP_KEY=
# Not read by the app at runtime; kept here for parity with the Jenkins
# credentials used during `php artisan passport:install` (see README).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
ROOT_PATH=http://laravel-nginx/
API_PORT=8080

# ── Shared: Mail ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=BudgetMaster

# ── Shared: React frontend ───────────────────────────────────────────────────
FRONTEND_PORT=80
REACT_APP_API_BASE_URL=http://localhost:8080/api/

# ── Dev only (docker-compose.yml) ────────────────────────────────────────────
# Local db container's credentials. DB_HOST stays "db" (the container name).
DB_DATABASE=budgetmaster
DB_USERNAME=budgetmaster
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_HOST=db
DB_PORT=3306
# Host port mapping used by docker-compose.override.yml (local dev only)
DB_DEV_PORT=3308

# ── Prod only (docker-compose.prod.yml) ──────────────────────────────────────
# No db container in prod — point these at your external MySQL server.
# Uncomment and fill in when deploying with docker-compose.prod.yml
# (DB_HOST/DB_PASSWORD have no default; the file requires them explicitly).
# DB_HOST=your-external-mysql-host
# DB_PORT=3306
# DB_DATABASE=budgetmaster
# DB_USERNAME=budgetmaster
# DB_PASSWORD=

# API_IMAGE=docker.io/yourusername/budgetmaster-api
# API_IMAGE_TAG=latest
# FRONTEND_IMAGE=docker.io/yourusername/budgetmaster-frontend
# FRONTEND_IMAGE_TAG=latest
# NGINX_IMAGE=docker.io/yourusername/budgetmaster-nginx
# NGINX_IMAGE_TAG=latest
